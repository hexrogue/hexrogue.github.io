# Copy to .env and fill in. .env is gitignored, never commit real keys here.

# Preferred: create an API key at https://imgflip.com/api-settings
IMGF_API_KEY=

# Legacy account login. Imgflip may reject these even when correct.
IMGF_USERNAME=
IMGF_PASSWORD=

# Optional: set to 1 to request watermark removal (needs Imgflip Premium)
NO_WATERMARK=0

# PostHog analytics. Hugo reads these from the process environment at build time.
# Local: put them in .env.local, then export before running Hugo:
#   set -a; . ./.env.local; set +a
# GitHub Actions: repository variables POSTHOG_PROJECT_TOKEN and POSTHOG_HOST.
# Host is usually https://us.i.posthog.com or https://eu.i.posthog.com.
HUGO_PARAMS_POSTHOG_PROJECT_TOKEN=
HUGO_PARAMS_POSTHOG_HOST=